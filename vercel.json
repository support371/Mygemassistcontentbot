{
  "version": 2,
  "functions": {
    "api/webhook.js": { "maxDuration": 10 },
    "api/set-webhook.js": { "maxDuration": 10 },
    "api/webhook-info.js": { "maxDuration": 10 },
    "api/activate.js": { "maxDuration": 10 },
    "api/automation.js": { "maxDuration": 30 },
    "api/secure-automation.js": { "maxDuration": 30 },
    "api/growth-status.js": { "maxDuration": 10 },
    "api/verify-growth-signature.js": { "maxDuration": 10 },
    "api/guide.js": { "maxDuration": 10 }
  },
  "crons": [
    {
      "path": "/api/automation",
      "schedule": "0 14 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/webhook", "dest": "/api/webhook.js" },
    { "src": "/api/set-webhook", "dest": "/api/set-webhook.js" },
    { "src": "/api/webhook-info", "dest": "/api/webhook-info.js" },
    { "src": "/api/activate", "dest": "/api/activate.js" },
    { "src": "/api/automation", "dest": "/api/automation.js" },
    { "src": "/api/automation.js", "dest": "/api/automation.js" },
    { "src": "/api/secure-automation", "dest": "/api/secure-automation.js" },
    { "src": "/api/growth-status", "dest": "/api/growth-status.js" },
    { "src": "/api/verify-growth-signature", "dest": "/api/verify-growth-signature.js" },
    { "src": "/api/start", "dest": "/api/start.js" },
    { "src": "/guide.pdf", "dest": "/api/guide.js" },
    { "src": "/api/guide", "dest": "/api/guide.js" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
