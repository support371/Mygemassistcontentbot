{
  "version": 2,
  "functions": {
    "api/webhook.js": {
      "maxDuration": 10
    },
    "api/set-webhook.js": {
      "maxDuration": 10
    },
    "api/guide.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.js"
    },
    {
      "src": "/api/set-webhook",
      "dest": "/api/set-webhook.js"
    },
    {
      "src": "/guide.pdf",
      "dest": "/api/guide.js"
    },
    {
      "src": "/api/guide",
      "dest": "/api/guide.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}
