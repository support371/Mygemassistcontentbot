{
  "version": 2,
  "functions": {
    "api/webhook.js": { "maxDuration": 10 },
    "api/set-webhook.js": { "maxDuration": 10 },
    "api/webhook-info.js": { "maxDuration": 10 },
    "api/guide.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/webhook", "dest": "/api/webhook.js" },
    { "src": "/api/set-webhook", "dest": "/api/set-webhook.js" },
    { "src": "/api/webhook-info", "dest": "/api/webhook-info.js" },
    { "src": "/api/start", "dest": "/api/start.js" },
    { "src": "/guide.pdf", "dest": "/api/guide.js" },
    { "src": "/api/guide", "dest": "/api/guide.js" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
