# Automatic growth engine
# CRON_SECRET is recommended. Vercel sends it as an Authorization bearer token.
CRON_SECRET=replace_with_long_random_cron_secret
# Google Apps Script web-app URL created from google-apps-script/Code.gs
GROWTH_STORE_URL=
# Optional additional shared key. Configure the same value in Apps Script properties.
