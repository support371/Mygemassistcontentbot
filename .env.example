# Required Telegram configuration
BOT_TOKEN=replace_with_rotated_botfather_token
BOT_USERNAME=Gemassistbuilder_Bot
CHANNEL_ID=-1001234567890
CHANNEL_URL=https://t.me/mycybersecureWealthsolution
WEBHOOK_SECRET=replace_with_telegram_webhook_secret
SETUP_KEY=replace_with_long_random_setup_key
PUBLIC_BASE_URL=https://mygemassistcontentbot.vercel.app

# Automatic growth engine
# CRON_SECRET is recommended. Vercel sends it as an Authorization bearer token.
CRON_SECRET=replace_with_long_random_cron_secret
# Google Apps Script web-app URL created from google-apps-script/Code.gs
GROWTH_STORE_URL=
# Optional additional shared key. Configure the same value in Apps Script properties.
GROWTH_STORE_KEY=

# Backward-compatible alias for an existing Apps Script endpoint
GOOGLE_APPS_SCRIPT_WEBHOOK=

# Guide
PDF_URL=https://mygemassistcontentbot.vercel.app/guide.pdf

# Public business details
WEBSITE_URL=https://gemcybersecurityassist.com
CONTACT_EMAIL=Marketing@gemcybersecurityassist.com
CONTACT_PHONE=+1 (401) 702-2460

# Optional
DROP_PENDING_UPDATES=false
TWITTER_URL=https://x.com/yourusername
TIKTOK_URL=https://www.tiktok.com/@yourusername
FACEBOOK_URL=https://www.facebook.com/yourpage
INSTAGRAM_URL=https://www.instagram.com/yourusername

# Open-weight AI (gpt-oss). No Claude or ChatGPT account involved.
# Every provider is optional; when all are unset or out of free quota the bot
# and channel fall back to their built-in content.
# 1) Cloudflare Workers AI, free plan: 10,000 Neurons/day, fails (never bills) when used up
CF_ACCOUNT_ID=
CF_AI_TOKEN=
# CF_AI_MODEL=@cf/openai/gpt-oss-120b
# CF_AI_FALLBACK_MODEL=@cf/openai/gpt-oss-20b
# 2) OpenRouter free tier (openai/gpt-oss-120b:free), 50 requests/day without credits
OPENROUTER_API_KEY=
# 3) Hugging Face router, optional
HF_TOKEN=

# TikTok (GEM Enterprise app: Login Kit + Content Posting API)
# Register https://mygemassistcontentbot.vercel.app/api/tiktok-auth as a redirect URI.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
